#!/usr/bin/env python3
"""PreToolUse hook: route a factory agent's Bash command through rtk, filtered.

Wired into .claude/settings.local.json by install-factory when the user opts in.
Reads the hook JSON on stdin, always exits 0, and prints nothing (the command runs
as written) unless all of these hold:

- the tool is Bash and the session's permission_mode is bypassPermissions, so
  intake (dontAsk) and interactive sessions are never touched;
- factory/install.json names an executable rtk_path;
- no segment of the command deletes (rm, rmdir, unlink, -delete), prints a full
  diff (git diff/show, git log -p, gh pr diff) or runs orca or factory/bin/*;
- `rtk hook claude` exits 0 with a JSON object.

Then it forwards only rtk's deny, or else rtk's updatedInput. Nothing else from
rtk is passed on, so the hook can never allow or ask: the deny rules still apply.
"""

import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
RTK_TIMEOUT = 5
PUNCTUATION = "();<>|&\n"
REDIRECT = re.compile(r"[<>&]*[<>][<>&]*\Z")
ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
DELETERS = {"rm", "rmdir", "unlink"}
GIT_OPTS_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env"}
FACTORY_BIN = re.compile(r"(\A|/)factory/bin/[^/]+\Z")


def segments(command):
    """Split a shell command into word lists on &&, ||, ;, | and newlines."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=PUNCTUATION)
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    lexer.commenters = ""
    out, words = [], []
    for token in lexer:
        if token and all(c in PUNCTUATION for c in token) and not REDIRECT.match(token):
            out.append(words)
            words = []
        else:
            words.append(token)
    out.append(words)
    return [w for w in out if w]


def program(words):
    """The words from the program on: skip NAME=value, `command` and `env` prefixes."""
    i = 0
    while i < len(words):
        if ASSIGNMENT.match(words[i]):
            i += 1
        elif words[i] in ("command", "env"):
            i += 1
            while i < len(words) and words[i].startswith("-"):
                i += 1
        else:
            break
    return words[i:]


def git_passthrough(args):
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in GIT_OPTS_WITH_VALUE else 1
    if i >= len(args):
        return False
    sub, rest = args[i], args[i + 1:]
    return sub in ("diff", "show") or (sub == "log" and any(a in ("-p", "-u", "--patch") for a in rest))


def passthrough(words):
    if any(os.path.basename(w) in DELETERS or w == "-delete" for w in words):
        return True
    prog = program(words)
    if not prog:
        return False
    name, args = os.path.basename(prog[0]), prog[1:]
    if name == "git":
        return git_passthrough(args)
    if name == "gh":
        return any(args[i:i + 2] == ["pr", "diff"] for i in range(len(args)))
    return name == "orca" or bool(FACTORY_BIN.search(prog[0]))


def rtk_path():
    try:
        path = json.loads((REPO / "factory" / "install.json").read_text()).get("rtk_path")
    except (OSError, ValueError, AttributeError):
        return None
    return path if isinstance(path, str) and os.path.isfile(path) and os.access(path, os.X_OK) else None


def decide(raw):
    try:
        event = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(event, dict) or event.get("tool_name") != "Bash":
        return None
    if event.get("permission_mode") != "bypassPermissions":
        return None
    rtk = rtk_path()
    command = (event.get("tool_input") or {}).get("command") if isinstance(event.get("tool_input"), dict) else None
    if not rtk or not isinstance(command, str):
        return None
    try:
        if any(passthrough(words) for words in segments(command)):
            return None
    except ValueError:
        return None
    try:
        res = subprocess.run([rtk, "hook", "claude"], input=raw, capture_output=True, timeout=RTK_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if res.returncode != 0:
        return None
    try:
        out = json.loads(res.stdout)
    except ValueError:
        return None
    hso = out.get("hookSpecificOutput") if isinstance(out, dict) else None
    if not isinstance(hso, dict):
        return None
    if hso.get("permissionDecision") == "deny":
        return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                       "permissionDecisionReason": hso.get("permissionDecisionReason")}}
    if isinstance(hso.get("updatedInput"), dict):
        return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": hso["updatedInput"]}}
    return None


def main():
    out = decide(sys.stdin.buffer.read())
    if out is not None:
        print(json.dumps(out))
    sys.exit(0)


if __name__ == "__main__":
    main()
